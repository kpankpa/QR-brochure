rules_version = '2';

// Firebase Storage Rules
// Deploy: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read for all QR code files (needed for QR scanners)
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Users can upload to their own folder: users/{userId}/...
    // Requires Firebase Authentication
    match /users/{userId}/{allPaths=**} {
      // Allow write if user is authenticated and uploading to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Restrict file size to 10MB
      allow write: if request.resource.size < 10 * 1024 * 1024;
      
      // Only allow specific file types
      allow write: if request.resource.contentType.matches('image/.*') 
                   || request.resource.contentType == 'application/pdf';
    }
  }
}
