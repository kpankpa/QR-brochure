rules_version = '2';

// Firestore Security Rules - Firebase Auth Only
// Deploy: firebase deploy --only firestore:rules
// Console: enable Firestore (Native mode) if you have not already.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Per-user brochure metadata (upload history)
    // Only authenticated users can read/write their own brochures
    match /users/{userId}/brochures/{docId} {
      // Users can only access their own brochures
      allow read: if isOwner(userId);
      
      // Users can only create/update their own brochures
      allow create: if isOwner(userId) 
                    && request.resource.data.keys().hasAll(['downloadUrl', 'fileName'])
                    && request.resource.data.downloadUrl is string
                    && request.resource.data.fileName is string;
      
      allow update: if isOwner(userId);
      
      // Users can delete their own brochures
      allow delete: if isOwner(userId);
    }

    // Optional: Admin collection (if needed)
    match /admin/{document=**} {
      allow read, write: if false; // Disable by default
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
