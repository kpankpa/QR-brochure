rules_version = '2';

// Firestore Security Rules - Firebase Auth Only
// Deploy: firebase deploy --only firestore:rules
// Console: enable Firestore (Native mode) if you have not already.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validSlug(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 40
        && value.matches('^[a-z0-9-]+$');
    }

    function publicCardPayload(slug) {
      return request.resource.data.keys().hasAll([
          'id', 'ownerId', 'slug', 'isPublished', 'fullName'
        ])
        && request.resource.data.id is string
        && request.resource.data.ownerId is string
        && validSlug(request.resource.data.slug)
        && request.resource.data.slug == slug
        && request.resource.data.isPublished == true
        && request.resource.data.fullName is string;
    }

    // Per-user brochure metadata (upload history)
    match /users/{userId}/brochures/{docId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['downloadUrl', 'fileName'])
        && request.resource.data.downloadUrl is string
        && request.resource.data.fileName is string;

      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Digital business cards — private editor documents
    match /users/{userId}/cards/{cardId} {
      allow read, write: if isOwner(userId);
    }

    // Public, published card snapshots — readable by anyone with the link.
    match /publicCards/{slug} {
      // Signed-in clients probe for slug availability; anonymous scanners may
      // read a published snapshot only.
      allow get: if isAuthenticated()
        || ('isPublished' in resource.data && resource.data.isPublished == true);
      allow list: if false;

      allow create: if isAuthenticated()
        && validSlug(slug)
        && publicCardPayload(slug)
        && request.resource.data.ownerId == request.auth.uid;

      // Ownership is immutable on update. Without the existing-owner check any
      // signed-in user could overwrite somebody else's published card.
      allow update: if isAuthenticated()
        && validSlug(slug)
        && publicCardPayload(slug)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        // Older snapshots had no `id`; allow the one-time migration while
        // keeping `id` immutable once present.
        && (!('id' in resource.data) || request.resource.data.id == resource.data.id)
        // Legacy snapshots may also lack a slug field. The document path already
        // fixes the slug, so only check it when present.
        && (!('slug' in resource.data) || resource.data.slug == slug)
        && (!('isPublished' in resource.data) || resource.data.isPublished == true);

      // Idempotent: deleting an already-missing public snapshot must not abort
      // a private card deletion batch.
      allow delete: if isAuthenticated()
        && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Lightweight scan events. No personal data is stored in these events.
    match /publicCards/{slug}/events/{eventId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['type', 'createdAt'])
        && request.resource.data.type is string
        && request.resource.data.type in ['view', 'save', 'share']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /admin/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
