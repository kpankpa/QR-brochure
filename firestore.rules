rules_version = '2';

// TEMPORARY FLEXIBLE RULES
// These rules are intentionally permissive while diagnosing a stubborn
// cloud_firestore/permission-denied error on card save/publish.
// TODO: tighten publicCards write access back to owner-only once the failing
// operation is identified.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Private editor documents and brochure history stay owner-scoped.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Public card snapshots: readable by anyone, writable by any signed-in
    // client so legacy documents with missing fields cannot block a save.
    match /publicCards/{slug} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /publicCards/{slug}/events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    // Catch-all: authenticated clients can use any other document path.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
